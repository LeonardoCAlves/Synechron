{
  "name": "decision-ledger",
  "version": "1.0.0",
  "private": true,
  "description": "A contract-first architecture decision service exposed through MCP.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "mcp": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run tests/contracts.test.ts tests/decision-service.test.ts",
    "test:integration": "vitest run tests/postgres-decision-repository.integration.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "contracts:generate": "tsx scripts/generate-contracts.ts",
    "contracts:check": "tsx scripts/generate-contracts.ts --check",
    "db:migrate": "node-pg-migrate up -m migrations",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run contracts:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2"
  }
}
